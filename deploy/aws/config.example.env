# Copy to deploy/aws/config.env (git-ignored), fill it in, then run deploy/aws/deploy.sh
STACK=borrowhood
AWS_REGION=eu-north-1            # Stockholm, closest to Norway
BRANCH=main                      # the server runs this branch from GitHub

ALERT_EMAIL=you@example.com      # alarms and budget alerts (confirm the email AWS sends you)
ADMIN_EMAIL=you@example.com      # BorrowHood master admin login
INSTANCE_TYPE=t4g.micro          # t4g.nano (cheapest, 0.5 GB) | t4g.micro (1 GB) | t4g.small (2 GB)
MONTHLY_BUDGET=10                # USD; alerts at 50% used and 100% forecast
SEED_DEMO=0                      # 1 = add the demo neighbourhoods and users

# Your domain. Leave these empty for the first deploy to use the free *.cloudfront.net address.
DOMAIN_NAME=                     # e.g. borrowhood.no (or www.borrowhood.no if your DNS can't alias the root)
CERTIFICATE_ARN=                 # ACM certificate for DOMAIN_NAME - must be created in us-east-1
HOSTED_ZONE_ID=                  # Route 53 zone ID; empty = you add the DNS records at your registrar
MAIL_DOMAIN=                     # e.g. borrowhood.no - verified in SES with DKIM
SES_FROM=                        # e.g. no-reply@borrowhood.no; empty = emails only go to the app log
