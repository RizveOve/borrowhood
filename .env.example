# Copy to .env and adjust. All values are optional for local development.
PORT=3000
APP_URL=http://localhost:3000
APP_TZ=Europe/Oslo

# Long random string – used to sign session cookies. REQUIRED in production.
SESSION_SECRET=replace-with-a-long-random-string
# Set to 1 when served over HTTPS (behind ALB/CloudFront)
COOKIE_SECURE=0

# Master admin (created on first start if no admin exists)
ADMIN_EMAIL=admin@borrowhood.no
ADMIN_NAME=BorrowHood Admin
ADMIN_PASSWORD=change-me-please

# Storage – leave S3_BUCKET empty to store photos on local disk (data/uploads)
DB_PATH=./data/borrowhood.db
S3_BUCKET=
AWS_REGION=eu-north-1

# Email – leave SES_FROM empty to print emails to the console
SES_FROM=
