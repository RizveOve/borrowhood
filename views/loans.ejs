<%- include('partials/top') %>
<h1><%= t('loans.title') %></h1>
<div class="seg" role="tablist">
  <a href="/loans?tab=lending" role="tab" aria-selected="<%= tab === 'lending' %>" class="<%= tab === 'lending' ? 'on' : '' %>"><%= t('loans.lending') %><% if (pendingCount) { %> <span class="dot dot-inline"><%= pendingCount %></span><% } %></a>
  <a href="/loans?tab=borrowing" role="tab" aria-selected="<%= tab === 'borrowing' %>" class="<%= tab === 'borrowing' ? 'on' : '' %>"><%= t('loans.borrowing') %></a>
</div>

<% const loans = tab === 'lending' ? lending : borrowing; const d0 = today(); %>
<% if (!loans.length) { %>
  <div class="empty">
    <% if (tab === 'lending') { %>
      <p><%= t('loans.empty_lending') %></p>
      <a href="/items/new" class="btn btn-primary"><%= t('browse.lend_cta') %></a>
    <% } else { %>
      <p><%= t('loans.empty_borrowing') %></p>
      <a href="/items" class="btn btn-primary"><%= t('loans.browse') %></a>
    <% } %>
  </div>
<% } else { %>
  <ul class="list">
    <% loans.forEach(l => { const st = loanState(l, d0); const done = ['declined', 'cancelled', 'returned'].includes(st); %>
      <li class="loan <%= done ? 'done' : '' %> <%= st === 'overdue' ? 'is-overdue' : '' %>">
        <a href="/items/<%= l.item_id %>" class="mini"><%- include('partials/thumb', { it: l }) %></a>
        <div class="grow">
          <div class="loan-head"><a href="/items/<%= l.item_id %>"><strong><%= l.title %></strong></a> <span class="badge badge-<%= st %>"><%= t('state.' + st) %></span><% if (l.issue) { %> <span class="badge badge-overdue"><%= t('loans.problem_badge') %></span><% } %></div>
          <div class="muted small"><%= fmtDate(l.start_date) %> – <%= fmtDate(l.end_date) %> ·
            <% if (tab === 'lending') { %><%= l.borrower_name %><%= l.borrower_flat ? ' (' + l.borrower_flat + ')' : '' %>
            <% } else { %><%= l.is_org ? 'BorrowHood' : l.owner_name %><% } %>
          </div>
          <% if (l.message && l.status === 'pending' && tab === 'lending') { %><div class="quote"><%= l.message %></div><% } %>
          <% if (l.status === 'approved') { %>
            <div class="small contact">
              <% if (tab === 'lending') { %>✉️ <a href="mailto:<%= l.borrower_email %>"><%= l.borrower_email %></a>
              <% } else if (l.is_org) { %>📍 <%= l.location %>
              <% } else { %>📍 <%= l.location %> · ✉️ <a href="mailto:<%= l.owner_email %>"><%= l.owner_email %></a><% } %>
            </div>
          <% } %>
          <% const step = photoStep(l, d0); %>
          <% if (l.pickupPhotos.length || l.returnPhotos.length) { %>
            <div class="loan-photos">
              <% ['pickup', 'return'].filter(k => l[k + 'Photos'].length).forEach(k => { const first = l[k + 'Photos'][0]; %>
                <div class="photo-group">
                  <div class="muted small"><%= t('loans.photos_' + k) %> · <%= fmtDateTime(first.created_at) %> · <%= first.user_name || '?' %></div>
                  <div class="photo-strip">
                    <% l[k + 'Photos'].forEach(p => { %>
                      <%- include('partials/loan-photo', { key: p.photo_key, gallery: 'loan-' + l.id, alt: t('loans.photos_' + k), caption: t('loans.photos_' + k) + ' · ' + fmtDateTime(p.created_at) + ' · ' + (p.user_name || '?') }) %>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
          <% if (l.issue) { %>
            <div class="issue">
              <div class="small"><strong>⚠️ <%= t('loans.problem_title') %></strong> · <span class="muted"><%= fmtDateTime(l.issue.created_at) %> · <%= l.issue.reporter_name || '?' %></span></div>
              <p class="issue-body"><%= l.issue.body %></p>
              <% if (l.issue.photos.length) { %>
                <div class="photo-strip">
                  <% l.issue.photos.forEach(p => { %>
                    <%- include('partials/loan-photo', { key: p.photo_key, gallery: 'loan-' + l.id, alt: t('loans.problem_title'), caption: t('loans.problem_title') + ' · ' + fmtDateTime(p.created_at) + ' · ' + (l.issue.reporter_name || '?') }) %>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% } %>
          <% if (tab === 'borrowing' && step) { %>
            <form method="post" action="/loans/<%= l.id %>/<%= step === 'pickup' ? 'picked-up' : 'hand-back' %>" enctype="multipart/form-data" class="photo-step" data-photo-step data-remove-label="<%= t('loans.remove_photo') %>" data-step-confirm="<%= t('loans.confirm_step') %>">
              <p class="small mb0"><%= t(step === 'pickup' ? 'loans.pickup_hint' : 'loans.return_hint') %></p>
              <div class="photo-strip">
                <span class="step-preview" data-step-preview></span>
                <label class="loan-photo add" title="<%= t('loans.choose_photos') %>">
                  <input type="file" name="photos" accept="image/*" multiple required data-step-photos>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8a2 2 0 0 1 2-2h2l2-2h6l2 2h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="4"/></svg>
                  <span class="sr-only"><%= t('loans.choose_photos') %></span>
                </label>
              </div>
              <div><button class="btn btn-primary btn-sm" data-step-submit><%= t(step === 'pickup' ? 'loans.got_it' : 'loans.hand_back') %></button></div>
            </form>
          <% } else if (tab === 'borrowing' && st === 'handed_back') { %>
            <p class="muted small mb0 step-note"><%= t('loans.wait_owner') %></p>
          <% } else if (tab === 'lending' && step === 'pickup') { %>
            <p class="muted small mb0 step-note"><%= t('loans.wait_pickup', { name: l.borrower_name }) %></p>
          <% } else if (tab === 'lending' && st === 'handed_back') { %>
            <p class="small mb0 step-note"><strong><%= t('loans.check_return') %></strong></p>
          <% } %>
          <div class="actions">
            <% if (tab === 'lending') { %>
              <% if (l.status === 'pending') { %>
                <form method="post" action="/loans/<%= l.id %>/approve"><button class="btn btn-primary btn-sm"><%= t('item.approve') %></button></form>
                <form method="post" action="/loans/<%= l.id %>/decline"><button class="btn btn-sm"><%= t('item.decline') %></button></form>
              <% } else if (st === 'active' || st === 'overdue' || st === 'handed_back') { %>
                <form method="post" action="/loans/<%= l.id %>/returned"><button class="btn btn-primary btn-sm"><%= t('item.mark_returned') %></button></form>
              <% } %>
            <% } else if (l.status === 'pending' || st === 'approved') { %>
              <form method="post" action="/loans/<%= l.id %>/cancel" data-confirm="<%= t('loans.cancel_confirm') %>"><button class="btn btn-sm"><%= t('item.cancel') %></button></form>
            <% } %>
            <% if (!done || l.issue) { %>
              <a class="btn btn-sm" href="/messages/with/<%= l.item_id %>/<%= tab === 'lending' ? l.borrower_id : l.owner_id %>">💬 <%= t('msg.message_btn') %></a>
            <% } %>
          </div>
          <% if (tab === 'lending' && (st === 'active' || st === 'overdue' || st === 'handed_back')) { %>
            <details class="problem">
              <summary class="btn btn-sm btn-danger-soft"><%= t('loans.problem_btn') %></summary>
              <form method="post" action="/loans/<%= l.id %>/problem" enctype="multipart/form-data" class="photo-step" data-photo-step data-remove-label="<%= t('loans.remove_photo') %>" data-step-confirm="<%= t('loans.problem_confirm', { name: l.borrower_name }) %>">
                <p class="small mb0"><%= t('loans.problem_hint', { name: l.borrower_name }) %></p>
                <textarea name="body" rows="3" maxlength="1000" minlength="5" required placeholder="<%= t('loans.problem_ph') %>"></textarea>
                <div class="photo-strip">
                  <span class="step-preview" data-step-preview></span>
                  <label class="loan-photo add" title="<%= t('loans.choose_photos') %>">
                    <input type="file" name="photos" accept="image/*" multiple data-step-photos>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8a2 2 0 0 1 2-2h2l2-2h6l2 2h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="4"/></svg>
                    <span class="sr-only"><%= t('loans.choose_photos') %></span>
                  </label>
                  <span class="muted small"><%= t('common.optional') %></span>
                </div>
                <div><button class="btn btn-sm btn-danger"><%= t('loans.problem_send') %></button></div>
              </form>
            </details>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/bottom') %>
